    Bucket8("Bucket 8 (nullableBoundary)<br />Deps: 34, 38<br /><br />ROOT Object{4}ᐸ{result}ᐳ[38]"):::bucket
    Bucket9("Bucket 9 (nullableBoundary)<br />Deps: 34<br /><br />ROOT PgCall{4}ᐸinout_argᐳ[34]"):::bucket
    end
    Bucket0 --> Bucket1 & Bucket2 & Bucket3 & Bucket4
