%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/v4/stream-connection-deduplication"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 7, 8, 10, 11, 12, 13, 27, 9, 16<br />2: PgSelect[6]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 6, 11, 12, 13<br /><br />ROOT PgSelectᐸperson+1ᐳ[6]<br />1: Connection[14]<br />2: ConnectionItems[17]"):::bucket
    Bucket3("Bucket 3 (nullableBoundary)<br />Deps: 14<br /><br />ROOT Connection{1}ᐸ6ᐳ[14]"):::bucket
    Bucket4("Bucket 4 (listItem)<br /><br />ROOT __Item{4}ᐸ17ᐳ[22]"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3 & Bucket4

    %% plan dependencies
    PgSelect6[["PgSelect[6∈0] ➊<br />ᐸperson+1ᐳ<br />More deps:<br />- Constantᐸ[HIDDEN]ᐳ[10]"]]:::plan
    Object9{{"Object[9∈0] ➊<br />ᐸ{pgSettings,withPgClient}ᐳ"}}:::plan
    Lambda16{{"Lambda[16∈0] ➊<br />ᐸresolveStreamDetailsᐳ<br />More deps:<br />- Constantᐸ[HIDDEN]ᐳ[27]"}}:::plan
    Object9 & Lambda16 --> PgSelect6
    Access7{{"Access[7∈0] ➊<br />ᐸ2.pgSettingsᐳ"}}:::plan
    Access8{{"Access[8∈0] ➊<br />ᐸ2.withPgClientᐳ"}}:::plan
    Access7 & Access8 --> Object9
    __Value2["__Value[2∈0] ➊<br />ᐸcontextᐳ"]:::plan
    __Value2 --> Access7
    __Value2 --> Access8
    Connection14[["Connection[14∈1] ➊<br />ᐸ6ᐳ"]]:::plan
    PgSelect6 --> Connection14
    ConnectionItems17[["ConnectionItems[17∈1@s] ➊"]]:::plan
    Connection14 --> ConnectionItems17
    PageInfo24{{"PageInfo[24∈3] ➊"}}:::plan
    Connection14 --> PageInfo24
    Access26{{"Access[26∈3] ➊<br />ᐸ14.hasNextPageᐳ"}}:::plan
    PageInfo24 o--o Access26
    __Item22[/"__Item[22∈4]<br />ᐸ17ᐳ"\]:::itemplan
    ConnectionItems17 ==> __Item22
    PgSelectSingle23{{"PgSelectSingle[23∈4]<br />ᐸpersonᐳ"}}:::plan
    __Item22 --> PgSelectSingle23
    PgClassExpression25{{"PgClassExpression[25∈4]<br />ᐸ__person__.”id”ᐳ"}}:::plan
    PgSelectSingle23 --> PgClassExpression25

    %% define steps
    classDef bucket0 stroke:#696969
    class Bucket0,__Value2,PgSelect6,Access7,Access8,Object9,Lambda16 bucket0
    classDef bucket1 stroke:#00bfff
    class Bucket1,Connection14,ConnectionItems17 bucket1
    classDef bucket3 stroke:#ffa500
    class Bucket3,PageInfo24,Access26 bucket3
    classDef bucket4 stroke:#0000ff
    class Bucket4,__Item22,PgSelectSingle23,PgClassExpression25 bucket4

