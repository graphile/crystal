%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/v4/stream-connection-has-next-page"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 7, 10, 11, 15, 16, 28, 29, 12, 27<br />2: PgSelect[9]<br />3: Connection[13]<br />4: ConnectionItems[17]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 13, 17, 15, 16, 7<br /><br />ROOT Connectionᐸ9ᐳ[13]"):::bucket
    Bucket3("Bucket 3 (listItem)<br /><br />ROOT __Item{3}ᐸ17ᐳ[22]"):::bucket
    Bucket4("Bucket 4 (nullableBoundary)<br />Deps: 23<br /><br />ROOT PgSelectSingle{3}ᐸpersonᐳ[23]"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3
    Bucket3 --> Bucket4

    %% plan dependencies
    PgSelect9[["PgSelect[9∈0] ➊<br />ᐸperson+1ᐳ<br />More deps:<br />- Constantᐸ3ᐳ[28]"]]:::plan
    Object12{{"Object[12∈0] ➊<br />ᐸ{pgSettings,withPgClient}ᐳ"}}:::plan
    Lambda27{{"Lambda[27∈0] ➊<br />ᐸresolveStreamDetailsᐳ<br />More deps:<br />- Constantᐸ[HIDDEN]ᐳ[29]"}}:::plan
    Object12 & Lambda27 --> PgSelect9
    Access10{{"Access[10∈0] ➊<br />ᐸ2.pgSettingsᐳ"}}:::plan
    Access11{{"Access[11∈0] ➊<br />ᐸ2.withPgClientᐳ"}}:::plan
    Access10 & Access11 --> Object12
    Connection13[["Connection[13∈0] ➊<br />ᐸ9ᐳ<br />Dependents: 3<br />More deps:<br />- Constantᐸ3ᐳ[28]"]]:::plan
    PgSelect9 --> Connection13
    __Value2["__Value[2∈0] ➊<br />ᐸcontextᐳ"]:::plan
    __Value2 --> Access10
    __Value2 --> Access11
    ConnectionItems17[["ConnectionItems[17∈0@s] ➊<br />More deps:<br />- Connection[13]"]]:::plan
    PageInfo20{{"PageInfo[20∈1] ➊<br />More deps:<br />- Connection[13]"}}:::plan
    Access24{{"Access[24∈1] ➊<br />ᐸ13.hasNextPageᐳ<br />More deps:<br />- Connection[13]"}}:::plan
    __Item22[/"__Item[22∈3]<br />ᐸ17ᐳ"\]:::itemplan
    ConnectionItems17 ==> __Item22
    PgSelectSingle23{{"PgSelectSingle[23∈3]<br />ᐸpersonᐳ"}}:::plan
    __Item22 --> PgSelectSingle23
    PgClassExpression25{{"PgClassExpression[25∈4]<br />ᐸ__person__.”id”ᐳ"}}:::plan
    PgSelectSingle23 --> PgClassExpression25

    %% define steps
    classDef bucket0 stroke:#696969
    class Bucket0,__Value2,PgSelect9,Access10,Access11,Object12,Connection13,ConnectionItems17,Lambda27 bucket0
    classDef bucket1 stroke:#00bfff
    class Bucket1,PageInfo20,Access24 bucket1
    classDef bucket3 stroke:#ffa500
    class Bucket3,__Item22,PgSelectSingle23 bucket3
    classDef bucket4 stroke:#0000ff
    class Bucket4,PgClassExpression25 bucket4

