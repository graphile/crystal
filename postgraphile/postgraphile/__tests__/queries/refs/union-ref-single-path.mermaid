    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/refs/union-ref-single-path"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 9, 10, 30, 11<br />2: PgSelect[8]<br />3: Connection[12]<br />4: ConnectionItems[14]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 12, 14, 11, 30<br /><br />ROOT Connectionᐸ8ᐳ[12]"):::bucket
    Bucket3("Bucket 3 (listItem)<br />Deps: 11, 30<br /><br />ROOT __Item{3}ᐸ14ᐳ[17]"):::bucket
    Bucket4("Bucket 4 (nullableBoundary)<br />Deps: 18, 11, 30<br /><br />ROOT PgSelectSingle{3}ᐸnotesᐳ[18]<br />1: <br />ᐳ: 19, 20<br />2: PgUnionAll[21]<br />ᐳ: 52, 25, 28, 29, 31, 32, 34, 35"):::bucket
    Bucket5("Bucket 5 (polymorphic)<br />__typename: Access[34]<br />Deps: 34, 11, 35"):::bucket
    Bucket6("Bucket 6 (polymorphicPartition)<br />|Organization<br />Deps: 11, 35<br />ᐳOrganization<br /><br />1: PgSelect[36]<br />2: PgSelectRows[41]<br />ᐳ: First[40], PgSelectSingle[42]"):::bucket
    Bucket7("Bucket 7 (polymorphicPartition)<br />|Person<br />Deps: 11, 35<br />ᐳPerson<br /><br />1: PgSelect[44]<br />2: PgSelectRows[49]<br />ᐳ: 48, 50, 51"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3
    Bucket3 --> Bucket4
    Bucket4 --> Bucket5
    Bucket5 --> Bucket6 & Bucket7

