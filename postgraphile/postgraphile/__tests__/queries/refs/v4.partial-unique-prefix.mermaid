%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/refs/v4.partial-unique-prefix"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: Access[9], Access[10], Object[11]<br />2: PgSelect[8]<br />3: Connection[12]<br />4: ConnectionItems[14]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 12, 14, 11<br /><br />ROOT Connectionᐸ8ᐳ[12]"):::bucket
    Bucket3("Bucket 3 (listItem)<br />Deps: 11<br /><br />ROOT __Item{3}ᐸ14ᐳ[17]"):::bucket
    Bucket4("Bucket 4 (nullableBoundary)<br />Deps: 11, 18<br /><br />ROOT PgSelectSingle{3}ᐸref_sourcesᐳ[18]<br />1: <br />ᐳ: 24, 25<br />2: PgSelect[20], PgSelect[31]<br />3: Connection[26], PgSelectRows[33]<br />ᐳ: 32, 34, 35<br />4: ConnectionItems[28]"):::bucket
    Bucket6("Bucket 6 (listItem)<br /><br />ROOT __Item{6}ᐸ28ᐳ[36]"):::bucket
    Bucket7("Bucket 7 (nullableBoundary)<br />Deps: 37<br /><br />ROOT PgSelectSingle{6}ᐸbooksᐳ[37]"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3
    Bucket3 --> Bucket4
    Bucket4 --> Bucket6
    Bucket6 --> Bucket7

    %% plan dependencies
    Object11{{"Object[11∈0] ➊<br />ᐸ{pgSettings,withPgClient}ᐳ<br />Dependents: 3"}}:::plan
    Access9{{"Access[9∈0] ➊<br />ᐸ2.pgSettingsᐳ"}}:::plan
    Access10{{"Access[10∈0] ➊<br />ᐸ2.withPgClientᐳ"}}:::plan
    Access9 & Access10 --> Object11
    PgSelect8[["PgSelect[8∈0] ➊<br />ᐸref_sourcesᐳ<br />More deps:<br />- Object[11]"]]:::plan
    __Value2["__Value[2∈0] ➊<br />ᐸcontextᐳ"]:::plan
    __Value2 --> Access9
    __Value2 --> Access10
    Connection12[["Connection[12∈0] ➊<br />ᐸ8ᐳ"]]:::plan
    PgSelect8 --> Connection12
    ConnectionItems14[["ConnectionItems[14∈0] ➊"]]:::plan
    Connection12 --> ConnectionItems14
    __Item17[/"__Item[17∈3]<br />ᐸ14ᐳ"\]:::itemplan
    ConnectionItems14 ==> __Item17
    PgSelectSingle18{{"PgSelectSingle[18∈3]<br />ᐸref_sourcesᐳ"}}:::plan
    __Item17 --> PgSelectSingle18
    PgSelect20[["PgSelect[20∈4]<br />ᐸbooksᐳ<br />More deps:<br />- Object[11]"]]:::plan
    PgClassExpression24{{"PgClassExpression[24∈4]<br />ᐸ__ref_sour...urce_book”ᐳ"}}:::plan
    PgClassExpression25{{"PgClassExpression[25∈4]<br />ᐸ__ref_sour...ource_pen”ᐳ"}}:::plan
    PgClassExpression24 & PgClassExpression25 --> PgSelect20
    PgSelect31[["PgSelect[31∈4]<br />ᐸbooks(aggregate)ᐳ<br />More deps:<br />- Object[11]"]]:::plan
    PgClassExpression24 & PgClassExpression25 --> PgSelect31
    PgSelectSingle18 --> PgClassExpression24
    PgSelectSingle18 --> PgClassExpression25
    Connection26[["Connection[26∈4]<br />ᐸ20ᐳ"]]:::plan
    PgSelect20 --> Connection26
    ConnectionItems28[["ConnectionItems[28∈4]"]]:::plan
    Connection26 --> ConnectionItems28
    First32{{"First[32∈4]"}}:::plan
    PgSelectRows33[["PgSelectRows[33∈4]"]]:::plan
    PgSelectRows33 --> First32
    PgSelect31 --> PgSelectRows33
    PgSelectSingle34{{"PgSelectSingle[34∈4]<br />ᐸbooksᐳ"}}:::plan
    First32 --> PgSelectSingle34
    PgClassExpression35{{"PgClassExpression[35∈4]<br />ᐸcount(*)ᐳ"}}:::plan
    PgSelectSingle34 --> PgClassExpression35
    __Item36[/"__Item[36∈6]<br />ᐸ28ᐳ"\]:::itemplan
    ConnectionItems28 ==> __Item36
    PgSelectSingle37{{"PgSelectSingle[37∈6]<br />ᐸbooksᐳ"}}:::plan
