{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["scripts/**/*"],
  "exclude": ["**/node_modules", "**/dist", "**/release", "**/versioned_docs"]
}
