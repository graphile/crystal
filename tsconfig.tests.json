{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": [
    "scripts/**/*",
    "utils/*/scripts/**/*",
    "grafast/*/scripts/**/*",
    "graphile-build/*/scripts/**/*",
    "postgraphile/*/scripts/**/*",
    "utils/*/__tests__/**/*",
    "grafast/*/__tests__/**/*",
    "graphile-build/*/__tests__/**/*",
    "postgraphile/*/__tests__/**/*"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/release", "**/versioned_docs", "**/dcc/dcc-types.ts"]
}
