    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/connections/custom-query-random-user-array-visible-messages"
    Bucket0("Bucket 0 (root)<br /><br />1: PgSelectInlineApply[26]<br />ᐳ: Access[7], Access[8], Object[9]<br />2: PgSelect[6]<br />ᐳ: Access[27]<br />3: PgSelectRows[10]"):::bucket
